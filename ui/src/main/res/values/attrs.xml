<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MeasurementTileView">
        <attr name="tileTitle" format="string" />
        <attr name="tileIcon" format="reference" />
        <attr name="tileColor" format="color|reference" />
    </declare-styleable>

    <declare-styleable name="ActionTileView">
        <attr name="actionTitle" format="string" />
        <attr name="actionIcon" format="reference" />
        <attr name="actionColor" format="color|reference" />
    </declare-styleable>

    <declare-styleable name="InfoCardView">
        <attr name="cardTitle" format="string" />
        <attr name="cardSubtitle" format="string" />
        <attr name="cardIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="MeasurementListItemView">
        <attr name="measurementTitle" format="string" />
        <attr name="measurementSubtitle" format="string" />
        <attr name="measurementIcon" format="reference" />
        <attr name="measurementIconTint" format="color|reference" />
    </declare-styleable>

    <declare-styleable name="AlertOverviewItemView">
        <attr name="alertTitle" format="string" />
        <attr name="alertSubtitle" format="string" />
        <attr name="alertColor" format="color|reference" />
    </declare-styleable>
</resources>
