<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg">

    <LinearLayout
        android:id="@+id/caregiver_dashboard_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter_horizontal"
        android:paddingTop="@dimen/screen_gutter_vertical"
        android:paddingEnd="@dimen/screen_gutter_horizontal"
        android:paddingBottom="@dimen/screen_gutter_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/caregiver_dashboard_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/caregiver_dashboard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/caregiver_dashboard_new_measurements_title"
                android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                android:textColor="@color/senior_text_primary"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/caregiver_dashboard_count_chip"
                style="@style/Widget.Senior.Card"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/spacing_s"
                app:cardBackgroundColor="@color/senior_danger"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="@id/caregiver_dashboard_title"
                app:layout_constraintBottom_toBottomOf="@id/caregiver_dashboard_title"
                app:layout_constraintStart_toEndOf="@id/caregiver_dashboard_title">

                <TextView
                    android:id="@+id/caregiver_dashboard_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingStart="@dimen/spacing_s"
                    android:paddingEnd="@dimen/spacing_s"
                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                    android:textColor="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/caregiver_dashboard_mark_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/caregiver_dashboard_mark_all"
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/caregiver_dashboard_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            app:checkedButton="@id/caregiver_dashboard_tab_new"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/caregiver_dashboard_tab_new"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/caregiver_dashboard_tab_new"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/caregiver_dashboard_tab_read"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:text="@string/caregiver_dashboard_tab_read"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/caregiver_dashboard_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
            android:textColor="@color/senior_text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/caregiver_dashboard_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_l"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
