<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/caregiver_add_dependent_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/senior_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:navigationIconTint="@color/white"
        app:title="@string/caregiver_add_dependent_title"
        app:subtitle="@string/caregiver_add_dependent_subtitle"
        app:titleTextAppearance="@style/TextAppearance.Senior.BodyLarge"
        app:subtitleTextAppearance="@style/TextAppearance.Senior.Caption"
        app:subtitleTextColor="@color/white"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:id="@+id/caregiver_add_dependent_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/caregiver_add_dependent_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <TextView
                android:id="@+id/caregiver_add_dependent_code_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/caregiver_add_dependent_enter_code_title"
                android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                android:textColor="@color/senior_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_enter_code_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/caregiver_link_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_enter_code"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/caregiver_add_dependent_link"
                style="@style/Widget.Senior.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/caregiver_link_connect" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@color/senior_outline" />

            <TextView
                android:id="@+id/caregiver_add_dependent_form_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/caregiver_add_dependent_form_header"
                android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                android:textColor="@color/senior_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_first_name_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/caregiver_add_dependent_first_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_first_name"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_last_name_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/caregiver_add_dependent_last_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_last_name"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_pesel_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/caregiver_add_dependent_pesel_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_pesel"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_phone_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/caregiver_add_dependent_phone_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_phone"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_add_dependent_address_input"
                style="@style/Widget.Senior.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/caregiver_add_dependent_address_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_add_dependent_address"
                    style="@style/Widget.Senior.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/caregiver_add_dependent_cancel"
                    style="@style/Widget.Senior.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/caregiver_add_dependent_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/caregiver_add_dependent_save"
                    style="@style/Widget.Senior.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:text="@string/caregiver_add_dependent_save" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/caregiver_add_dependent_code_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/caregiver_add_dependent_code_title"
                    android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                    android:textColor="@color/senior_text_primary" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Senior.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="@color/senior_bg">

                    <TextView
                        android:id="@+id/caregiver_add_dependent_code_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="@dimen/spacing_l"
                        android:text="@string/caregiver_add_dependent_code_placeholder"
                        android:textAppearance="@style/TextAppearance.Senior.TitleLarge"
                        android:textColor="@color/senior_primary"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/caregiver_add_dependent_copy"
                    style="@style/Widget.Senior.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/caregiver_add_dependent_copy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/caregiver_add_dependent_code_info"
                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                    android:textColor="@color/senior_text_secondary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
