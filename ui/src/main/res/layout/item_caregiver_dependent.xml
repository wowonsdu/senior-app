<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Senior.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_s"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/caregiver_dependent_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="JK"
            android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caregiver_dependent_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Jan Kowalski"
            android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
            android:textColor="@color/senior_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caregiver_dependent_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="234234234"
            android:textAppearance="@style/TextAppearance.Senior.Caption"
            android:textColor="@color/senior_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/caregiver_dependent_select"
            style="@style/Widget.Senior.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/caregiver_dependents_select" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
