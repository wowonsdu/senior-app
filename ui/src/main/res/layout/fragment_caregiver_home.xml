<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_info"
    android:padding="@dimen/spacing_l">

    <ImageButton
        android:id="@+id/caregiver_home_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="@null"
        android:src="@android:drawable/ic_media_previous"
        android:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/caregiver_home_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Opiekun (placeholder)"
        android:textAppearance="@style/TextAppearance.Senior.TitleLarge"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/caregiver_home_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caregiver_home_card"
        style="@style/Widget.Senior.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        app:layout_constraintTop_toBottomOf="@id/caregiver_home_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zalogowany numer:"
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_text_secondary" />

            <TextView
                android:id="@+id/caregiver_home_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="-"
                android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                android:textColor="@color/senior_info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="Ten ekran jest tymczasowy do czasu wdrozenia Etapu 5."
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/caregiver_home_logout"
                style="@style/Widget.Senior.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="Wyloguj" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

