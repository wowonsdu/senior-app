<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/caregiver_home_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/senior_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/menu_caregiver_home"
        app:title="@string/caregiver_home_title"
        app:subtitle="@string/caregiver_home_subtitle"
        app:titleTextAppearance="@style/TextAppearance.Senior.BodyLarge"
        app:subtitleTextAppearance="@style/TextAppearance.Senior.Caption"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/caregiver_home_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/caregiver_home_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabIndicatorColor="@color/senior_primary"
        app:tabSelectedTextColor="@color/senior_primary"
        app:tabTextColor="@color/senior_text_secondary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/caregiver_home_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/caregiver_home_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
