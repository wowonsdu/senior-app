<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sugar_dialog_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert_drop"
            android:tint="@color/senior_info" />

        <TextView
            android:id="@+id/sugar_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_sugar_dialog_title"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
            android:textColor="@color/senior_text_primary" />

        <ImageButton
            android:id="@+id/sugar_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/senior_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/sugar_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/patient_sugar_dialog_subtitle"
        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
        android:textColor="@color/senior_text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sugar_dialog_value_input"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="@string/patient_sugar_dialog_hint"
        app:boxStrokeColor="@color/senior_info"
        app:hintTextColor="@color/senior_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sugar_dialog_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/patient_sugar_dialog_unit"
        android:textAppearance="@style/TextAppearance.Senior.Caption"
        android:textColor="@color/senior_text_tertiary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sugar_dialog_cancel"
            style="@style/Widget.Senior.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/patient_sugar_dialog_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sugar_dialog_save"
            style="@style/Widget.Senior.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_sugar_dialog_save" />
    </LinearLayout>

</LinearLayout>
