<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="@color/senior_secondary" />

        <TextView
            android:id="@+id/patient_add_agent_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_add_agent_title"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
            android:textColor="@color/senior_text_primary" />

        <ImageButton
            android:id="@+id/patient_add_agent_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/senior_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/patient_add_agent_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/patient_add_agent_subtitle"
        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
        android:textColor="@color/senior_text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_add_agent_name_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="@string/patient_add_agent_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_add_agent_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_add_agent_role_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="@string/patient_add_agent_role_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_add_agent_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_add_agent_phone_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="@string/patient_add_agent_phone_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_add_agent_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_add_agent_email_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="@string/patient_add_agent_email_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_add_agent_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/patient_add_agent_cancel"
            style="@style/Widget.Senior.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/patient_add_agent_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/patient_add_agent_save"
            style="@style/Widget.Senior.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_add_agent_save" />
    </LinearLayout>

</LinearLayout>

