<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/design_book_title"
            android:textAppearance="@style/TextAppearance.Senior.TitleLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/design_book_section_buttons"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Senior.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/design_book_button_primary" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Senior.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/design_book_button_secondary" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Senior.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/design_book_button_danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_tiles"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <zdrowy.senior.io.ui.views.MeasurementTileView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:tileTitle="@string/design_book_tile_sugar"
            app:tileIcon="@android:drawable/ic_menu_info_details"
            app:tileColor="@color/senior_primary" />

        <zdrowy.senior.io.ui.views.MeasurementTileView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:tileTitle="@string/design_book_tile_insulin"
            app:tileIcon="@android:drawable/ic_menu_edit"
            app:tileColor="@color/senior_secondary" />

        <zdrowy.senior.io.ui.views.MeasurementTileView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:tileTitle="@string/design_book_tile_pressure"
            app:tileIcon="@android:drawable/ic_menu_compass"
            app:tileColor="@color/senior_danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_actions"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <zdrowy.senior.io.ui.views.ActionTileView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:actionTitle="@string/design_book_action_call_help"
            app:actionIcon="@android:drawable/ic_dialog_alert"
            app:actionColor="@color/senior_danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_list_cards"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <zdrowy.senior.io.ui.views.InfoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardTitle="@string/design_book_card_sugar_value"
            app:cardSubtitle="@string/design_book_card_sugar_time"
            app:cardIcon="@android:drawable/ic_menu_today" />

        <zdrowy.senior.io.ui.views.InfoCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardTitle="@string/design_book_card_agent_name"
            app:cardSubtitle="@string/design_book_card_agent_phone"
            app:cardIcon="@android:drawable/ic_menu_call" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_measurement_list"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <zdrowy.senior.io.ui.views.MeasurementListItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:measurementTitle="@string/design_book_measurement_sugar_value"
            app:measurementSubtitle="@string/design_book_measurement_time"
            app:measurementIcon="@android:drawable/ic_menu_info_details"
            app:measurementIconTint="@color/senior_primary" />

        <zdrowy.senior.io.ui.views.MeasurementListItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:measurementTitle="@string/design_book_measurement_pressure_value"
            app:measurementSubtitle="@string/design_book_measurement_time"
            app:measurementIcon="@android:drawable/ic_menu_compass"
            app:measurementIconTint="@color/senior_danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_alerts_overview"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <include layout="@layout/view_alerts_overview_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_alerts"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Senior.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="@color/senior_warning">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_l"
                android:text="@string/design_book_alert_example"
                android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                android:textColor="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/design_book_section_dialogs"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Senior.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_l"
                android:text="@string/design_book_dialog_example"
                android:textAppearance="@style/TextAppearance.Senior.BodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/design_book_section_dialog_inputs"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Senior.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:hint="@string/design_book_dialog_input_name">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.Senior.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Senior.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:hint="@string/design_book_dialog_input_course"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                style="@style/Widget.Senior.AutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/patient_add_disease_course_options"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
