<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg"
    android:padding="@dimen/spacing_l">

    <TextView
        android:id="@+id/caregiver_dependents_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/caregiver_dependents_header"
        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
        android:textColor="@color/senior_text_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/caregiver_dependents_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m"
        app:layout_constraintTop_toBottomOf="@id/caregiver_dependents_header"
        app:layout_constraintBottom_toTopOf="@id/caregiver_dependents_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/caregiver_dependents_add"
        style="@style/Widget.Senior.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/caregiver_dependents_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
