<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/caregiver_measurement_card"
    style="@style/Widget.Senior.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_s"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/senior_warning_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/caregiver_measurement_icon_card"
            style="@style/Widget.Senior.Card"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/senior_primary"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/caregiver_measurement_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/caregiver_measurement_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                    android:textColor="@color/senior_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/caregiver_measurement_type_chip"
                    style="@style/Widget.Senior.Card"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    app:cardBackgroundColor="@color/senior_primary"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/caregiver_measurement_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingStart="@dimen/spacing_s"
                        android:paddingEnd="@dimen/spacing_s"
                        android:textAppearance="@style/TextAppearance.Senior.Caption"
                        android:textColor="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/caregiver_measurement_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_text_secondary" />

            <TextView
                android:id="@+id/caregiver_measurement_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_text_tertiary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/caregiver_measurement_action"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/caregiver_dashboard_mark_read"
            android:textAllCaps="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
