<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert_medical"
            android:tint="@color/senior_danger" />

        <TextView
            android:id="@+id/patient_edit_disease_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_edit_disease_title"
            android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
            android:textColor="@color/senior_text_primary" />

        <ImageButton
            android:id="@+id/patient_edit_disease_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/senior_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/patient_edit_disease_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/patient_add_disease_subtitle"
        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
        android:textColor="@color/senior_text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_edit_disease_name_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="@string/patient_add_disease_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_edit_disease_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_edit_disease_since_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="@string/patient_add_disease_since_hint">

        <com.google.android.material.textfield.TextInputEditText
            style="@style/Widget.Senior.TextInputEditText"
            android:id="@+id/patient_edit_disease_since"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/patient_edit_disease_course_input"
        style="@style/Widget.Senior.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="@string/patient_add_disease_course_hint"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/patient_edit_disease_course"
            style="@style/Widget.Senior.AutoCompleteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/patient_add_disease_course_options"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/patient_edit_disease_delete"
            style="@style/Widget.Senior.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/patient_edit_remove" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/patient_edit_disease_save"
            style="@style/Widget.Senior.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:text="@string/patient_add_disease_save" />
    </LinearLayout>

</LinearLayout>
