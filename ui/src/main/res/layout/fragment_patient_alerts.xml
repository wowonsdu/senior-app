<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/patient_alerts_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/senior_warning"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:navigationIconTint="@color/white"
        app:title="@string/patient_alerts_title"
        app:subtitle="@string/patient_alerts_subtitle"
        app:titleTextAppearance="@style/TextAppearance.Senior.BodyLarge"
        app:subtitleTextAppearance="@style/TextAppearance.Senior.Caption"
        app:subtitleTextColor="@color/white"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:id="@+id/patient_alerts_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/patient_alerts_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Senior.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/senior_warning_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_alert_bell"
                            android:tint="@color/senior_warning" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_m"
                            android:layout_weight="1"
                            android:text="@string/alerts_overview_title"
                            android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                            android:textColor="@color/senior_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:text="@string/alerts_overview_body"
                        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                        android:textColor="@color/senior_text_secondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/alerts_overview_body_low_high"
                        android:textAppearance="@style/TextAppearance.Senior.Caption"
                        android:textColor="@color/senior_text_secondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/alerts_overview_body_spike"
                        android:textAppearance="@style/TextAppearance.Senior.Caption"
                        android:textColor="@color/senior_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Senior.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                app:cardBackgroundColor="@color/senior_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_drop"
                        android:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alert_item_title_sugar"
                            android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/alert_item_subtitle_sugar"
                            android:textAppearance="@style/TextAppearance.Senior.Caption"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Senior.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:text="@string/patient_alerts_config_enable_sugar"
                            android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                            android:textColor="@color/senior_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/patient_alerts_config_section_critical"
                        android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                        android:textColor="@color/senior_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Senior.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_height_compact"
                            android:layout_weight="1"
                            android:hint="@string/patient_alerts_config_low_hint"
                            app:suffixText="mg/dL">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/Widget.Senior.TextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Senior.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_height_compact"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:hint="@string/patient_alerts_config_high_hint"
                            app:suffixText="mg/dL">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/Widget.Senior.TextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_critical_low_caption"
                            android:textAppearance="@style/TextAppearance.Senior.Caption"
                            android:textColor="@color/senior_text_tertiary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_critical_high_caption"
                            android:textAppearance="@style/TextAppearance.Senior.Caption"
                            android:textColor="@color/senior_text_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/patient_alerts_config_section_spike"
                        android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                        android:textColor="@color/senior_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:text="@string/patient_alerts_config_spike_toggle"
                            android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                            android:textColor="@color/senior_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Senior.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_height_compact"
                            android:layout_weight="1"
                            android:hint="@string/patient_alerts_config_spike_percent_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/Widget.Senior.TextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Senior.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_height_compact"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:hint="@string/patient_alerts_config_spike_measurements_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                style="@style/Widget.Senior.TextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Senior.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        app:cardBackgroundColor="@color/senior_bg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/spacing_m"
                            android:text="@string/patient_alerts_config_example"
                            android:textAppearance="@style/TextAppearance.Senior.Caption"
                            android:textColor="@color/senior_text_secondary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/patient_alerts_config_section_channels"
                        android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                        android:textColor="@color/senior_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/patient_alerts_config_channels_hint"
                        android:textAppearance="@style/TextAppearance.Senior.Caption"
                        android:textColor="@color/senior_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            style="Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_channels_enable_all" />

                        <com.google.android.material.button.MaterialButton
                            style="Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_channels_disable_all" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Senior.Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/tile_height"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/white">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_alert_tile_outline_primary"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_s">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:contentDescription="@null"
                                    android:src="@android:drawable/sym_action_chat"
                                    android:tint="@color/senior_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_s"
                                    android:text="@string/patient_alerts_config_channel_sms"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                                    android:textColor="@color/senior_text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_alerts_config_channel_sms_subtitle"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                                    android:textColor="@color/senior_text_secondary" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:checked="true" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Senior.Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/tile_height"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/white">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_alert_tile_outline_primary"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_s">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:contentDescription="@null"
                                    android:src="@android:drawable/ic_dialog_email"
                                    android:tint="@color/senior_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_s"
                                    android:text="@string/patient_alerts_config_channel_email"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                                    android:textColor="@color/senior_text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_alerts_config_channel_email_subtitle"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                                    android:textColor="@color/senior_text_secondary" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:checked="true" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Senior.Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/tile_height"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/white">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_alert_tile_outline_primary"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_s">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_alert_bell"
                                    android:tint="@color/senior_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_s"
                                    android:text="@string/patient_alerts_config_channel_app"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                                    android:textColor="@color/senior_text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_alerts_config_channel_app_subtitle"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                                    android:textColor="@color/senior_text_secondary" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:checked="true" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/patient_alerts_config_caregivers_title"
                        android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                        android:textColor="@color/senior_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/patient_alerts_config_caregivers_subtitle"
                        android:textAppearance="@style/TextAppearance.Senior.Caption"
                        android:textColor="@color/senior_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            style="Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_caregivers_select_all" />

                        <com.google.android.material.button.MaterialButton
                            style="Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:text="@string/patient_alerts_config_caregivers_deselect_all" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Senior.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_alert_tile_outline_neutral"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_m">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_alerts_config_agent_name"
                                    android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                                    android:textColor="@color/senior_text_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_alerts_config_agent_phone"
                                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                                    android:textColor="@color/senior_text_secondary" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_myplaces"
                                android:tint="@color/senior_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Senior.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                app:cardBackgroundColor="@color/senior_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_medical"
                        android:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alert_item_title_insulin"
                            android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/alert_item_subtitle_insulin"
