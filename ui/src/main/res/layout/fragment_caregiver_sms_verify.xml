<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_info"
    android:padding="@dimen/spacing_l">

    <ImageButton
        android:id="@+id/caregiver_sms_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="@null"
        android:src="@android:drawable/ic_media_previous"
        android:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caregiver_sms_role_chip"
        style="@style/Widget.Senior.Card"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/spacing_l"
        app:cardBackgroundColor="@color/senior_primary"
        app:layout_constraintTop_toBottomOf="@id/caregiver_sms_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:text="@string/caregiver_login_role_label"
            android:textAppearance="@style/TextAppearance.Senior.Caption"
            android:textColor="@color/white" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/caregiver_sms_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/sms_verify_title"
        android:textAppearance="@style/TextAppearance.Senior.TitleLarge"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/caregiver_sms_role_chip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/caregiver_sms_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/caregiver_login_subtitle"
        android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/caregiver_sms_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caregiver_sms_card"
        style="@style/Widget.Senior.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        app:layout_constraintTop_toBottomOf="@id/caregiver_sms_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="@color/senior_info" />

            <TextView
                android:id="@+id/caregiver_sms_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/sms_verify_header"
                android:textAppearance="@style/TextAppearance.Senior.TitleMedium"
                android:textColor="@color/senior_text_primary" />

            <TextView
                android:id="@+id/caregiver_sms_sent_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/sms_verify_sent_to"
                android:textAppearance="@style/TextAppearance.Senior.Caption"
                android:textColor="@color/senior_text_secondary" />

            <TextView
                android:id="@+id/caregiver_sms_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/sms_verify_phone"
                android:textAppearance="@style/TextAppearance.Senior.BodyMedium"
                android:textColor="@color/senior_info" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/caregiver_sms_dev_mode"
                style="@style/Widget.Senior.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                app:cardBackgroundColor="@color/senior_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m"
                    android:text="@string/sms_verify_dev_code_alt"
                    android:textAppearance="@style/TextAppearance.Senior.BodyLarge"
                    android:textColor="@color/senior_info"
                    android:textStyle="bold"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caregiver_sms_code_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:hint="@string/sms_verify_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiver_sms_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/caregiver_sms_confirm"
                style="@style/Widget.Senior.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/sms_verify_confirm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/caregiver_sms_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sms_verify_resend"
                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                    android:textColor="@color/senior_info" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="@string/sms_verify_change"
                    android:textAppearance="@style/TextAppearance.Senior.Caption"
                    android:textColor="@color/senior_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/caregiver_sms_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_footer"
        android:textAppearance="@style/TextAppearance.Senior.Caption"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
