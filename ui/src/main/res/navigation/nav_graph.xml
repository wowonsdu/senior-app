<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/roleSelectFragment">

    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="zdrowy.senior.io.ui.auth.RoleSelectFragment"
        android:label="@string/role_select_app_name"
        tools:layout="@layout/fragment_role_select">
        <action
            android:id="@+id/action_roleSelect_to_patientLogin"
            app:destination="@id/patientLoginFragment" />
        <action
            android:id="@+id/action_roleSelect_to_caregiverLogin"
            app:destination="@id/caregiverLoginFragment" />
        <action
            android:id="@+id/action_roleSelect_to_devHub"
            app:destination="@id/devHubFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientLoginFragment"
        android:name="zdrowy.senior.io.ui.auth.PatientLoginFragment"
        android:label="@string/role_select_app_name"
        tools:layout="@layout/fragment_patient_login">
        <action
            android:id="@+id/action_patientLogin_to_patientSmsVerify"
            app:destination="@id/patientSmsVerifyFragment" />
        <action
            android:id="@+id/action_patientLogin_to_devHub"
            app:destination="@id/devHubFragment" />
    </fragment>

    <fragment
        android:id="@+id/caregiverLoginFragment"
        android:name="zdrowy.senior.io.ui.auth.CaregiverLoginFragment"
        android:label="@string/role_select_app_name"
        tools:layout="@layout/fragment_caregiver_login">
        <action
            android:id="@+id/action_caregiverLogin_to_caregiverSmsVerify"
            app:destination="@id/caregiverSmsVerifyFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientSmsVerifyFragment"
        android:name="zdrowy.senior.io.ui.auth.PatientSmsVerifyFragment"
        android:label="@string/role_select_app_name"
        tools:layout="@layout/fragment_patient_sms_verify">
        <action
            android:id="@+id/action_patientSmsVerify_to_patientHome"
            app:destination="@id/patientHomeFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientHomeFragment"
        android:name="zdrowy.senior.io.ui.patient.PatientHomeFragment"
        android:label="@string/patient_home_title"
        tools:layout="@layout/fragment_patient_home">
        <action
            android:id="@+id/action_patientHome_to_patientSugarDialog"
            app:destination="@id/patientSugarDialogFragment" />
        <action
            android:id="@+id/action_patientHome_to_patientInsulinDialog"
            app:destination="@id/patientInsulinDialogFragment" />
        <action
            android:id="@+id/action_patientHome_to_patientPressureDialog"
            app:destination="@id/patientPressureDialogFragment" />
        <action
            android:id="@+id/action_patientHome_to_patientPulseDialog"
            app:destination="@id/patientPulseDialogFragment" />
    </fragment>

    <dialog
        android:id="@+id/patientSugarDialogFragment"
        android:name="zdrowy.senior.io.ui.patient.PatientSugarDialogFragment"
        android:label="@string/patient_sugar_dialog_title"
        tools:layout="@layout/dialog_patient_sugar" />

    <dialog
        android:id="@+id/patientInsulinDialogFragment"
        android:name="zdrowy.senior.io.ui.patient.PatientInsulinDialogFragment"
        android:label="@string/patient_insulin_dialog_title"
        tools:layout="@layout/dialog_patient_insulin" />

    <dialog
        android:id="@+id/patientPressureDialogFragment"
        android:name="zdrowy.senior.io.ui.patient.PatientPressureDialogFragment"
        android:label="@string/patient_pressure_dialog_title"
        tools:layout="@layout/dialog_patient_pressure" />

    <dialog
        android:id="@+id/patientPulseDialogFragment"
        android:name="zdrowy.senior.io.ui.patient.PatientPulseDialogFragment"
        android:label="@string/patient_pulse_dialog_title"
        tools:layout="@layout/dialog_patient_pulse" />

    <fragment
        android:id="@+id/caregiverSmsVerifyFragment"
        android:name="zdrowy.senior.io.ui.auth.CaregiverSmsVerifyFragment"
        android:label="@string/role_select_app_name"
        tools:layout="@layout/fragment_caregiver_sms_verify" />

    <fragment
        android:id="@+id/devHubFragment"
        android:name="zdrowy.senior.io.ui.dev.DevHubFragment"
        android:label="@string/dev_hub_title"
        tools:layout="@layout/fragment_dev_hub">
        <action
            android:id="@+id/action_devHub_to_roleSelect"
            app:destination="@id/roleSelectFragment" />
        <action
            android:id="@+id/action_devHub_to_patientLogin"
            app:destination="@id/patientLoginFragment" />
        <action
            android:id="@+id/action_devHub_to_caregiverLogin"
            app:destination="@id/caregiverLoginFragment" />
        <action
            android:id="@+id/action_devHub_to_patientSmsVerify"
            app:destination="@id/patientSmsVerifyFragment" />
        <action
            android:id="@+id/action_devHub_to_caregiverSmsVerify"
            app:destination="@id/caregiverSmsVerifyFragment" />
        <action
            android:id="@+id/action_devHub_to_patientHome"
            app:destination="@id/patientHomeFragment" />
    </fragment>
</navigation>
