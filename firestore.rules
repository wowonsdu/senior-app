rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function careLinkId(patientUid, caregiverUid) {
      return patientUid + "_" + caregiverUid;
    }

    function isCaregiverOf(patientUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/careLinks/$(careLinkId(patientUid, request.auth.uid)));
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isPatient(uid) {
      return roleOf(uid) == "PATIENT";
    }

    function isCaregiver(uid) {
      return roleOf(uid) == "CAREGIVER";
    }

    function isLinkedPatientToCaregiver(caregiverUid) {
      return isSignedIn()
        && isPatient(request.auth.uid)
        && exists(/databases/$(database)/documents/careLinks/$(careLinkId(request.auth.uid, caregiverUid)));
    }

    function isAccessCodeOwner() {
      return resource != null && resource.data.ownerUid == request.auth.uid;
    }

    function isValidAccessCodeType(type) {
      return type == "PATIENT_TO_CAREGIVER" || type == "CAREGIVER_TO_PATIENT";
    }

    function hasValidAccessCodeCreatePayload(code) {
      return request.resource.data.code is string
        && request.resource.data.code == code
        && request.resource.data.code.matches('^[0-9]{6}$')
        && request.resource.data.expiresAtMs is number
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type is string
        && isValidAccessCodeType(request.resource.data.type)
        && (!('phoneNumberE164' in request.resource.data)
            || (request.resource.data.phoneNumberE164 is string
                && request.resource.data.phoneNumberE164 != ""));
    }

    function isPatientCodeCreate() {
      return request.resource.data.type == "PATIENT_TO_CAREGIVER"
        && isPatient(request.auth.uid)
        && request.resource.data.patientUid is string
        && request.resource.data.patientUid == request.auth.uid;
    }

    function isCaregiverCodeCreate() {
      return request.resource.data.type == "CAREGIVER_TO_PATIENT"
        && isCaregiver(request.auth.uid)
        && request.resource.data.caregiverUid is string
        && request.resource.data.caregiverUid == request.auth.uid
        && (!('phoneNumberE164' in request.resource.data)
            || request.auth.token.phone_number == null
            || request.resource.data.phoneNumberE164 != request.auth.token.phone_number);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isCaregiverOf(uid));

      match /settings/personalData {
        allow read: if isSignedIn()
          && (request.auth.uid == uid
              || isCaregiverOf(uid)
              || isLinkedPatientToCaregiver(uid));
        allow write: if isSignedIn()
          && (request.auth.uid == uid || isCaregiverOf(uid));
      }

      match /{document=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isCaregiverOf(uid));
      }
    }

    match /careLinks/{linkId} {
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.patientUid == request.auth.uid
            || resource.data.caregiverUid == request.auth.uid);

      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.patientUid is string
        && request.resource.data.caregiverUid is string
        && linkId == careLinkId(request.resource.data.patientUid, request.resource.data.caregiverUid)
        && isPatient(request.resource.data.patientUid)
        && isCaregiver(request.resource.data.caregiverUid)
        && (request.auth.uid == request.resource.data.patientUid
            || request.auth.uid == request.resource.data.caregiverUid);

      allow update, delete: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || resource.data.caregiverUid == request.auth.uid)
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.caregiverUid == resource.data.caregiverUid
        && linkId == careLinkId(resource.data.patientUid, resource.data.caregiverUid)
        && isPatient(resource.data.patientUid)
        && isCaregiver(resource.data.caregiverUid);
    }

    match /accessCodes/{code} {
      allow create: if isSignedIn()
        && hasValidAccessCodeCreatePayload(code)
        && (isPatientCodeCreate() || isCaregiverCodeCreate());
      allow get: if isSignedIn();
      allow delete: if isSignedIn()
        && (
          isAccessCodeOwner()
          || (resource.data.type == "PATIENT_TO_CAREGIVER" && isCaregiver(request.auth.uid))
          || (resource.data.type == "CAREGIVER_TO_PATIENT" && isPatient(request.auth.uid))
        );
      allow list: if false;
      allow update: if false;
    }

    match /agentAccessCodes/{code} {
      allow create: if isSignedIn()
        && request.resource.data.contactId is string
        && request.resource.data.patientUid == request.auth.uid;
      allow get, delete: if isSignedIn()
        && resource.data.patientUid == request.auth.uid;
      allow list: if false;
      allow update: if false;
    }

  }
}
