<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_200"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_blue_light"
            android:padding="20dp">

            <TextView
                android:id="@+id/caregiver_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/caregiver_title"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                style="@style/Widget.Senior.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/active_patient_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_active_label"
                        style="@style/Widget.Senior.SectionSubtitle"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/active_patient_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_none_selected"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/primary_blue"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/select_patient_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_select"
                        android:backgroundTint="@color/primary_blue"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/open_home_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_home"
                        android:backgroundTint="@color/green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
